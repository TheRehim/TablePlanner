# Copy to .env and fill in. NEVER commit the real .env.

# Postgres. compose.yaml sets this for you automatically in local dev.
DATABASE_URL=postgres://tableplanner:change-me@localhost:5432/tableplanner

# Random, at least 32 chars. `npm run hash-password` prints one for you.
SESSION_SECRET=

# scrypt hash of the editor password. Generate with: npm run hash-password
# The plaintext never leaves your machine; only this hash is stored.
# Format is scrypt:N:r:p:salt:key - ':' not '$', so Docker Compose and the
# shell cannot mangle it through variable interpolation.
EDITOR_PASSWORD_HASH=

PORT=3000

# Set true only when served over HTTPS, or the session cookie is never stored.
COOKIE_SECURE=false
