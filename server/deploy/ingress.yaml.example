# Phase 7 only. Applying this PUBLISHES the app to the internet.
#
# Do not apply until:
#   - a domain and DNS record exist                     (needs your approval)
#   - cert-manager issues the certificate               (needs your approval)
#   - anonymous read-only has been verified from a LOGGED-OUT browser
#   - COOKIE_SECURE is flipped to "true" in the Deployment
#   - <meta name="robots" content="noindex"> is in index.html
#
# Remember the guest list contains real names.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: tableplanner
  namespace: apps
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
spec:
  ingressClassName: traefik
  tls:
    - hosts: [REPLACE.example.com]
      secretName: tableplanner-tls
  rules:
    - host: REPLACE.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: tableplanner
                port:
                  name: http
